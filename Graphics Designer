<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JN Garcia - Freelance Graphic Designer Portfolio</title>
    <style>
        /* General Styles */
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f4f7f6;
            color: #333;
            line-height: 1.6;
        }

        /* Header / Hero Section */
        header {
            background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
            color: white;
            text-align: center;
            padding: 60px 20px;
        }

        /* Logo / Icon Container Style */
        .profile-img {
            width: 110px;
            height: 110px;
            border-radius: 50%;
            object-fit: contain;
            border: 4px solid white;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
            margin-bottom: 20px;
            background-color: #ffffff;
            padding: 10px;
        }

        header h1 {
            margin: 0;
            font-size: 2.5rem;
        }

        header p {
            font-size: 1.1rem;
            margin-top: 10px;
            opacity: 0.9;
        }

        .container {
            max-width: 1000px;
            margin: 40px auto;
            padding: 0 20px;
        }

        /* Services & Portfolio Sections */
        .services, .portfolio, .contact {
            background: white;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            margin-bottom: 30px;
        }

        h2 {
            text-align: center;
            color: #2575fc;
            margin-bottom: 30px;
        }

        .service-grid, .portfolio-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
        }

        .service-card {
            background: #f9f9f9;
            padding: 25px;
            border-radius: 8px;
            text-align: center;
            border-top: 4px solid #2575fc;
        }

        .service-card h3 {
            margin-top: 0;
            color: #333;
        }

        /* Portfolio Gallery Cards */
        .portfolio-item {
            background: #fff;
            border-radius: 8px;
            overflow: hidden;
            border: 1px solid #eaeaea;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
            transition: transform 0.3s ease;
        }

        .portfolio-item:hover {
            transform: translateY(-5px);
        }

        .portfolio-item img {
            width: 100%;
            height: 200px;
            object-fit: cover;
        }

        .portfolio-info {
            padding: 15px;
            text-align: center;
        }

        .portfolio-info h4 {
            margin: 0 0 5px 0;
            color: #333;
        }

        .portfolio-info p {
            margin: 0;
            font-size: 0.9rem;
            color: #666;
        }

        /* Contact Section */
        .contact {
            text-align: center;
        }

        .btn {
            display: inline-block;
            background: #2575fc;
            color: white;
            padding: 12px 30px;
            border-radius: 25px;
            text-decoration: none;
            font-weight: bold;
            margin-top: 15px;
            transition: background 0.3s ease;
        }

        .btn:hover {
            background: #1a5bc9;
        }

        footer {
            text-align: center;
            padding: 20px;
            font-size: 0.9rem;
            color: #777;
        }
    </style>
</head>
<body>

    <!-- Header / Hero Section with Graphic Designer Logo -->
    <header>
        <!-- Modern Graphic Designer Logo (Pen / Brush vector icon) -->
        <img src="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%232575fc' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='M12 19l7-7 3 3-7 7-3-3z'></path><path d='M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z'></path><path d='M2 2l7.586 7.586'></path><circle cx='11' cy='11' r='2'></circle></svg>" alt="JN Garcia Logo" class="profile-img">
        <h1>Hello! I'm JN Garcia</h1>
        <p>Freelance Graphic Designer helping bring your ideas and brand to life.</p>
    </header>

    <div class="container">
        
        <!-- Services Section -->
        <section class="services">
            <h2>What I Can Do For You</h2>
            <div class="service-grid">
                <div class="service-card">
                    <h3>🎨 Branding & Logo Design</h3>
                    <p>Creating unique and professional logos and visual identities tailored for your business or brand.</p>
                </div>
                <div class="service-card">
                    <h3>💌 Custom Invitations</h3>
                    <p>Specialized designs for weddings, birthdays, christenings, and other special milestones.</p>
                </div>
                <div class="service-card">
                    <h3>📱 Social Media & Print</h3>
                    <p>Posters, banners, social media graphics, flyers, and other promotional materials to make your brand stand out.</p>
                </div>
            </div>
        </section>

        <!-- Portfolio Gallery Section -->
        <section class="portfolio">
            <h2>Recent Works</h2>
            <div class="portfolio-grid">
                <!-- Portfolio Item 1: Logo -->
                <div class="portfolio-item">
                    <img src="https://images.unsplash.com/photo-1626785774573-4b799315345d?auto=format&fit=crop&w=500&q=80" alt="Logo Design">
                    <div class="portfolio-info">
                        <h4>Brand Logo Design</h4>
                        <p>Modern minimalist logo concept</p>
                    </div>
                </div>
                <!-- Portfolio Item 2: Invitation/Artistic -->
                <div class="portfolio-item">
                    <img src="https://images.unsplash.com/photo-1513519245088-0e12902e5a38?auto=format&fit=crop&w=500&q=80" alt="Custom Invitation">
                    <div class="portfolio-info">
                        <h4>Custom Invitation</h4>
                        <p>Elegant floral event stationery</p>
                    </div>
                </div>
                <!-- Portfolio Item 3: Digital/Graphics -->
                <div class="portfolio-item">
                    <img src="https://images.unsplash.com/photo-1558655146-d09347e92766?auto=format&fit=crop&w=500&q=80" alt="Social Media Graphics">
                    <div class="portfolio-info">
                        <h4>Social Media & Print</h4>
                        <p>Creative promotional graphics</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Contact Section -->
        <section class="contact">
            <h2>Want to Collaborate?</h2>
            <p>Have a project in mind or need creative design work? Let's talk!</p>
            <a href="mailto:your-jnreactivated@gmail.com" class="btn">Email Me Now</a>
        </section>

    </div>

    <footer>
        <p>&copy; 2024-2026 JN Garcia. All Rights Reserved.</p>
    </footer>

</body>
</html>
